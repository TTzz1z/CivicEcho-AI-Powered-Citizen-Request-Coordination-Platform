{$SITE_ADDRESS:localhost} {
	# Keep backend-only endpoints out of the frontend's SPA fallback.
	@internal path /metrics* /docs /docs/* /redoc /redoc/* /openapi.json /openapi.json/
	handle @internal {
		respond 404
	}
	handle {
		# Use the same API body limits and response headers as the local gateway.
		reverse_proxy frontend:80
	}
	encode gzip
}
