# ============================================================
# 倾听助手 生产等价环境配置模板
# 复制为 .env.prod 后填入真实强秘密
# 启动: docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up -d --wait
# ============================================================

# --- 必填：强秘密（至少 32 字符，不含 change-me/development/default 等弱标记） ---
JWT_SECRET=<生成: openssl rand -hex 32>
SERVICE_API_TOKEN=<生成: openssl rand -hex 32>
POSTGRES_PASSWORD=<生成: openssl rand -hex 24>

# --- 生产标识 ---
APP_ENV=production

# --- 域名与 CORS（必须为显式白名单，不允许 *） ---
SITE_ADDRESS=your-domain.com
CORS_ORIGINS=https://your-domain.com

# --- 数据库 ---
POSTGRES_DB=tingting
POSTGRES_USER=tingting

# --- 对象存储（生产必须使用强凭据） ---
# SeaweedFS 只接入私有网络，存储使用新卷；旧 MinIO 卷的数据须通过联合备份迁移。
PRODUCTION_OBJECT_STORAGE_ENDPOINT=object-storage:8333
OBJECT_STORAGE_ACCESS_KEY=<生成: openssl rand -hex 12>
OBJECT_STORAGE_SECRET_KEY=<生成: openssl rand -hex 24>
OBJECT_STORAGE_BUCKET=tingting-attachments
KB_UPLOAD_BUCKET=tingting-kb
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_SECURE=false

# --- 恶意文件扫描（生产强制开启） ---
MALWARE_SCAN_MODE=clamd
MALWARE_SCAN_URL=clamav:3310
MALWARE_SCAN_REQUIRE_CLEAN=true
MALWARE_SCAN_TIMEOUT_SECONDS=30

# --- 自助注册与限流 ---
ALLOW_CITIZEN_SELF_REGISTER=true
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
REGISTER_RATE_LIMIT_ATTEMPTS=10
REGISTER_RATE_LIMIT_WINDOW_SECONDS=300
ANON_TICKET_RATE_LIMIT_ATTEMPTS=15
ANON_TICKET_RATE_LIMIT_WINDOW_SECONDS=300
UPLOAD_RATE_LIMIT_ATTEMPTS=30
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60
AI_RATE_LIMIT_ATTEMPTS=30
AI_RATE_LIMIT_WINDOW_SECONDS=60
EXPORT_RATE_LIMIT_ATTEMPTS=10
EXPORT_RATE_LIMIT_WINDOW_SECONDS=60

# --- 日志 ---
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

# --- 时区 ---
DEFAULT_TIMEZONE=Asia/Shanghai

# --- Worker ---
WORKER_ENABLED=true
WORKER_SCAN_INTERVAL_SECONDS=60
WORKER_DUE_SOON_HOURS=4
ANONYMOUS_RETENTION_DAYS=30
WORKER_OUTBOX_RETENTION_DAYS=90
WORKER_AI_RETENTION_DAYS=180
WORKER_ORPHAN_GRACE_DAYS=7

# --- AI 大模型（留空 AI_API_KEY 则降级为规则引擎） ---
AI_PROVIDER=rules
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=30
AI_MAX_TOKENS=1024

# --- 可选：OIDC ---
OIDC_ENABLED=false
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://your-domain.com/auth/oidc/callback
